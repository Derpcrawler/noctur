#!/bin/bash
# Noctur: runs after install, and after upgrade on every package type (deb and rpm call it on
# upgrades too; pacman gets it as post_upgrade through electron-builder.yml). Based on
# electron-builder's after-install template with the paths written out, so the same file works
# where electron-builder does not fill in its macros. Every step can run again safely.

if type update-alternatives >/dev/null 2>&1; then
    # Remove previous link if it doesn't use update-alternatives
    if [ -L '/usr/bin/noctur' -a -e '/usr/bin/noctur' -a "`readlink '/usr/bin/noctur'`" != '/etc/alternatives/noctur' ]; then
        rm -f '/usr/bin/noctur'
    fi
    update-alternatives --install '/usr/bin/noctur' 'noctur' '/opt/Noctur/noctur' 100 || ln -sf '/opt/Noctur/noctur' '/usr/bin/noctur'
else
    ln -sf '/opt/Noctur/noctur' '/usr/bin/noctur'
fi

# Check if user namespaces are supported by the kernel and working with a quick test:
if ! { [[ -L /proc/self/ns/user ]] && unshare --user true; }; then
    # Use SUID chrome-sandbox only on systems without user namespaces:
    chmod 4755 '/opt/Noctur/chrome-sandbox' || true
else
    chmod 0755 '/opt/Noctur/chrome-sandbox' || true
fi

# TUN mode: the core needs CAP_NET_ADMIN for the TUN device and routes and CAP_NET_BIND_SERVICE for
# DNS on port 53. File capabilities give it only these; the core runs as the user, not as root.
# The app can set or remove them later (Settings, Core).
for core in mihomo; do
    file='/opt/Noctur/resources/sidecar/'"$core"
    [ -f "$file" ] || continue
    chown root:root "$file"
    chmod 0755 "$file"
    if command -v setcap >/dev/null 2>&1; then
        setcap cap_net_admin,cap_net_bind_service=+ep "$file" || echo "Could not set capabilities on $file; TUN mode will ask for them"
    else
        echo "setcap not found; TUN mode will ask for capabilities on first use"
    fi
done

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# Install apparmor profile. (Ubuntu 24+)
# First check if the version of AppArmor running on the device supports our profile.
# This is in order to keep backwards compatibility with Ubuntu 22.04 which does not support abi/4.0.
# In that case, we just skip installing the profile since the app runs fine without it on 22.04.
if apparmor_status --enabled > /dev/null 2>&1; then
  APPARMOR_PROFILE_SOURCE='/opt/Noctur/resources/apparmor-profile'
  APPARMOR_PROFILE_TARGET='/etc/apparmor.d/noctur'
  if apparmor_parser --skip-kernel-load --debug "$APPARMOR_PROFILE_SOURCE" > /dev/null 2>&1; then
    cp -f "$APPARMOR_PROFILE_SOURCE" "$APPARMOR_PROFILE_TARGET"

    # Updating the current AppArmor profile is not possible and probably not meaningful in a chroot'ed environment.
    if ! { [ -x '/usr/bin/ischroot' ] && /usr/bin/ischroot; } && hash apparmor_parser 2>/dev/null; then
      apparmor_parser --replace --write-cache --skip-read-cache "$APPARMOR_PROFILE_TARGET"
    fi
  else
    echo "Skipping the installation of the AppArmor profile as this version of AppArmor does not seem to support the bundled profile"
  fi
fi
